# ==============================================================================
# Konfigurace AVA Operation Log (AVA Monitor)
# ==============================================================================

# Port, na kterém aplikace naslouchá na hostitelském serveru (lze změnit např. na 8502)
HOST_PORT=8501

# Port uvnitř kontejneru (Streamlit výchozí 8501)
PORT=8501

# Název Docker kontejneru
CONTAINER_NAME=ava-monitor

# Časové pásmo kontejneru
TZ=Europe/Prague

# Přihlašovací údaje pro Avaplace Data Service API (volitelné, lze zadat i v UI)
AVA_PROD_CLIENT_ID=ava-monitor
AVA_PROD_CLIENT_SECRET=
AVA_ALPHA_CLIENT_ID=ASOLEU-AVAmonitor-AP-
AVA_ALPHA_CLIENT_SECRET=
